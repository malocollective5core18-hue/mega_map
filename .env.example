DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=stocktaking.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=true
SITE_URL=https://example.test
# Optional: if set, this URL takes precedence over the local POSTGRES_* settings.
DATABASE_URL=
DB_SSL_REQUIRE=false
DB_CONN_MAX_AGE=60
POSTGRES_DB=stocktaking
POSTGRES_USER=stocktaking
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:8000
PRIVACY_NOTICE_VERSION=2026-10-location-v1
# Broad Tanzania service bounding box; replace with the owner-approved service boundary.
SERVICE_REGION_MIN_LAT=-11.8
SERVICE_REGION_MAX_LAT=-0.9
SERVICE_REGION_MIN_LNG=29.2
SERVICE_REGION_MAX_LNG=40.7
LOCATION_MAX_ACCURACY_M=100000
LOCATION_MAX_FIX_AGE_SECONDS=120
LOCATION_FUTURE_SKEW_SECONDS=30
LOCATION_WARN_ACCURACY_M=50
LOCATION_MOVING_SPEED_MPS=1.5
LOCATION_LARGE_OFFSET_M=250
PROVIDER_CODE_TTL_SECONDS=1800
PUBLIC_API_RATE=60/min
CODE_VERIFY_RATE=30/hour
SUBMISSION_RATE=10/hour
# Set to the named owner's staff email only after the owner approves MFA recovery authority.
MFA_RECOVERY_OWNER_EMAIL=
# Optional password-only exception for the named superuser account. MFA remains required for all other staff.
MFA_EXEMPT_SUPERUSER_EMAIL=
